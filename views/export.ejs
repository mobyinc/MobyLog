<% 
let messageHtml = '';
if (typeof message !== 'undefined' && message) {
    messageHtml = '<div class="alert alert-info">' + message + '</div>';
}
%>
<%- include('layout', { 
    title: 'Export Data - MobyLog', 
    showNavbar: true, 
    admin: admin,
    body: `
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h4 class="mb-0"><i class="bi bi-download me-2"></i>Export Data</h4>
                    </div>
                    <div class="card-body">
                        ` + messageHtml + `
                        
                        <form action="/export" method="POST">
                            <div class="mb-3">
                                <label for="email" class="form-label">Send report to:</label>
                                <input type="email" 
                                       class="form-control" 
                                       id="email" 
                                       name="email" 
                                       placeholder="Enter email address" 
                                       required>
                                <div class="form-text">The exported data will be sent to this email address.</div>
                            </div>
                            
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-send me-2"></i>Send Export
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    `
}) %>