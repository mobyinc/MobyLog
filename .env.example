# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/mobylog

# Server port
PORT=4242

# SendGrid API key for sending emails
SENDGRID_API_KEY=your-sendgrid-api-key

# Public URL of the application (used in emails)
PUBLIC_URL=http://localhost:4242

# Storage root for reports
STORAGE_ROOT=.

# Initial admin email (defaults to admin@mobyinc.com if not set)
INITIAL_ADMIN_EMAIL=admin@mobyinc.com

# JWT secret for token generation (CHANGE THIS IN PRODUCTION)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Session secret (CHANGE THIS IN PRODUCTION)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Node environment (development/production)
NODE_ENV=development